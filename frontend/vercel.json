{
  "rewrites": [{ "source": "/:path((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/[...path].js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
